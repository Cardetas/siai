source /etc/network/interfaces.d/*

# The loopback network interface
auto lo
iface lo inet loopback

# Interconnection Link to gw.port
auto enp0s3
iface enp0s3 inet static
    address 10.10.254.2/24
    gateway 10.10.254.1
    dns-nameservers 10.10.254.1 1.1.1.1
    dns-search port.dom.pt usa.dom.pt dom.pt
    up ip route replace 10.10.20.0/24 via 10.10.254.1
    up ip route replace 172.16.20.0/24 via 10.10.254.1

# USA Internal Network
auto enp0s8
iface enp0s8 inet static
    address 10.10.40.1/24

# USA DMZ Network
auto enp0s9
iface enp0s9 inet static
    address 172.16.40.1/24
