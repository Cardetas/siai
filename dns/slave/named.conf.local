// Include TSIG key for authenticated zone transfers
include "/etc/bind/tsig.key";

zone "dom.pt" {
    type slave;
    file "/var/lib/bind/dom.pt.db";
    masters { 10.10.254.1 key "tsig-key"; };
};

zone "port.dom.pt" {
    type slave;
    file "/var/lib/bind/port.dom.pt.db";
    masters { 10.10.254.1 key "tsig-key"; };
};

zone "usa.dom.pt" {
    type slave;
    file "/var/lib/bind/usa.dom.pt.db";
    masters { 10.10.254.1 key "tsig-key"; };
};

zone "20.10.10.in-addr.arpa" {
    type slave;
    file "/var/lib/bind/INTERNAL_PORT_rev.db";
    masters { 10.10.254.1 key "tsig-key"; };
};

zone "20.16.172.in-addr.arpa" {
    type slave;
    file "/var/lib/bind/DMZ_PORT_rev.db";
    masters { 10.10.254.1 key "tsig-key"; };
};

zone "40.10.10.in-addr.arpa" {
    type slave;
    file "/var/lib/bind/INTERNAL_USA_rev.db";
    masters { 10.10.254.1 key "tsig-key"; };
};

zone "40.16.172.in-addr.arpa" {
    type slave;
    file "/var/lib/bind/DMZ_USA_rev.db";
    masters { 10.10.254.1 key "tsig-key"; };
};
