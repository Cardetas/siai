include "/etc/bind/tsig.key";


// Main Domain
zone "dom.pt" {
    type master;
    file "/var/lib/bind/dom.pt.db";
    dnssec-policy default;
    key-directory "/var/lib/bind";
    allow-transfer { key "tsig-key"; };
    also-notify { 10.10.254.2; };
    notify yes;
};

// PORT Sub-domain
zone "port.dom.pt" {
    type master;
    file "/var/lib/bind/port.dom.pt.db";
    allow-update { key "tsig-key"; };
    allow-transfer { key "tsig-key"; };
    also-notify { 10.10.254.2; };
    notify yes;
};

// USA Sub-domain
zone "usa.dom.pt" {
    type master;
    file "/var/lib/bind/usa.dom.pt.db";
    allow-update { key "tsig-key"; };
    allow-transfer { key "tsig-key"; };
    also-notify { 10.10.254.2; };
    notify yes;
};

// PORT Internal (10.10.20.0/24)
zone "20.10.10.in-addr.arpa" {
    type master;
    file "/var/lib/bind/INTERNAL_PORT_rev.db";
    allow-update { key "tsig-key"; };
    allow-transfer { key "tsig-key"; };
    also-notify { 10.10.254.2; };
    notify yes;
};

// PORT DMZ (172.16.20.0/24)
zone "20.16.172.in-addr.arpa" {
    type master;
    file "/var/lib/bind/DMZ_PORT_rev.db";
    allow-update { key "tsig-key"; };
    allow-transfer { key "tsig-key"; };
    also-notify { 10.10.254.2; };
    notify yes;
};

// USA Internal (10.10.40.0/24)
zone "40.10.10.in-addr.arpa" {
    type master;
    file "/var/lib/bind/INTERNAL_USA_rev.db";
    allow-update { key "tsig-key"; };
    allow-transfer { key "tsig-key"; };
    also-notify { 10.10.254.2; };
    notify yes;
};

// USA DMZ (172.16.40.0/24)
zone "40.16.172.in-addr.arpa" {
    type master;
    file "/var/lib/bind/DMZ_USA_rev.db";
    allow-update { key "tsig-key"; };
    allow-transfer { key "tsig-key"; };
    also-notify { 10.10.254.2; };
    notify yes;
};
