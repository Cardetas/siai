$TTL    86400
@       IN      SOA     dns1.port.dom.pt. admin.port.dom.pt. (
                        2026111101      ; Serial
                        3600            ; Refresh
                        1800            ; Retry
                        604800          ; Expire
                        86400 )         ; Negative Cache TTL

; Name Servers Authoritative for port.dom.pt
@       IN      NS      dns1.port.dom.pt.
@       IN      NS      dns2.usa.dom.pt.

; Gateway & DNS Servers
gw      IN      A       10.10.20.1
gw      IN      A       172.16.20.1
gw      IN      A       10.10.254.1

dns1    IN      A       10.10.254.1
dns1    IN      A       10.10.20.1

; Registered Servers
ldap    IN      A       172.16.20.10
mail    IN      A       172.16.20.20

; Dynamic clients will be registered here by Kea DHCP-DDNS
