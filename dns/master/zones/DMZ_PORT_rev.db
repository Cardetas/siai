$TTL    86400
@       IN      SOA     dns1.port.dom.pt. admin.port.dom.pt. (
                        2026111101      ; Serial
                        3600            ; Refresh
                        1800            ; Retry
                        604800          ; Expire
                        86400 )         ; Negative Cache TTL

@       IN      NS      dns1.port.dom.pt.
@       IN      NS      dns2.usa.dom.pt.

; Gateway & Servers in PORT DMZ
1       IN      PTR     gw.port.dom.pt.
10      IN      PTR     ldap.port.dom.pt.
20      IN      PTR     mail.port.dom.pt.
