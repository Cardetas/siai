options {
    directory "/var/cache/bind";

    allow-query { any; };

    recursion yes;
    allow-recursion {
        127.0.0.0/8;
        10.10.20.0/24;
        172.16.20.0/24;
        10.10.254.0/24;
        10.10.40.0/24;
        172.16.40.0/24;
    };

    dnssec-validation auto;

    forwarders {
        1.1.1.1;
        1.0.0.1;
    };
};
